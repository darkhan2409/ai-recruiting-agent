# HCB Recruiting Agent — пример переменных окружения
# Скопировать в .env и заполнить реальными значениями.
# .env в .gitignore — никогда не коммитить.

# Режим разработки: True → LLMExtractor и IMAPSource возвращают мок-данные
USE_MOCKS=True

# --- Инфраструктура (БЛОК 1) ---

# PostgreSQL (асинхронный драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://hcb:hcb@postgres:5432/hcb

# Qdrant
QDRANT_URL=http://qdrant:6333

# Расписание APScheduler
INGESTION_INTERVAL_SECONDS=60
RETENTION_CRON_HOUR=3

# Версия приложения (для /health)
APP_VERSION=0.1.0

# --- Ingestion (БЛОК 2) ---

# IMAP (Yandex.Mail App Password). Пустые → используется FolderSource.
# Поддерживается только SSL (порт 993). Для plain IMAP (143) потребуется
# `MailBoxUnencrypted` — добавляется при необходимости.
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Хранилища (внутри контейнера)
INBOX_DIR=/app/storage/inbox
RESUMES_DIR=/app/storage/resumes

# Лимит вложения, MB
MAX_ATTACHMENT_MB=10

# --- Parsing (БЛОК 3) ---

# OpenAI ключ. Пустой → LLMExtractor работает в mock-режиме при USE_MOCKS=True.
OPENAI_API_KEY=
LLM_EXTRACT_MODEL=gpt-4o-mini
LLM_EXTRACT_TEMPERATURE=0.0

# --- Заполняется в последующих БЛОКах ---

# Embeddings (БЛОК 4) — e5 | openai
# EMBEDDER=e5

# Retention (БЛОК 9, DATA_POLICY)
# RESUME_RETENTION_DAYS=180
